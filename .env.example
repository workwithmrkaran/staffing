# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Standard connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://a3a_app:change-me@localhost:5432/a3a_staffing
# Set to "true" for hosted Postgres that requires TLS (most cloud providers).
DATABASE_SSL=false
# Set to "false" only if your provider uses a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Max connections per server instance (keep low on serverless hosts).
DATABASE_POOL_MAX=5

# ── Admin console (/admin) ─────────────────────────────────────────────────
# Password used to sign in to /admin. Use a long, unique passphrase.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random secret (32+ chars) used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ── Public site ───────────────────────────────────────────────────────────
# Live domain, used for canonical URLs, sitemap.xml and social previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
